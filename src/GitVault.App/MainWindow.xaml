<Window x:Class="GitVault.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GitVault · 离线代码库" Width="1180" Height="820" MinWidth="980" MinHeight="680"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="84" /><RowDefinition Height="80" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Border Background="White" BorderBrush="#E1E7EB" BorderThickness="0,0,0,1" Padding="28,18">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button Content="打开 Vault" Command="{Binding OpenVaultCommand}" />
                    <Button Content="新建 Vault" Command="{Binding CreateVaultCommand}" />
                    <Button Content="设置" Command="{Binding SettingsCommand}" Margin="0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource Accent}" Width="40" Height="40" CornerRadius="10" Margin="0,0,12,0">
                        <TextBlock Text="G" Foreground="White" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel><TextBlock Text="GitVault" FontSize="24" FontWeight="Bold" /><TextBlock Text="离线代码库 / OFFLINE GIT" FontSize="10" Foreground="{StaticResource Muted}" /></StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Row="1" Margin="28,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding VaultTitle}" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="{Binding VaultPath}" Foreground="{StaticResource Muted}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ComboBox ItemsSource="{Binding VaultChoices}" SelectedItem="{Binding SelectedVault}" DisplayMemberPath="Label" Width="240" Padding="8" Margin="12,0" IsEnabled="{Binding CanWork}" AutomationProperties.Name="选择 Vault 位置" />
                <TextBlock Text="{Binding ConnectionText}" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,18,0" />
                <Button Content="扫描设备" Command="{Binding DiscoverCommand}" />
                <Button Content="刷新" Command="{Binding RefreshCommand}" Margin="0" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="2" Margin="28,0,28,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="266" /><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Background="White" CornerRadius="10" BorderBrush="#DFE6EA" BorderThickness="1">
                <DockPanel Margin="16">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="仓库" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,14" />
                        <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="搜索仓库" ToolTip="按仓库名称搜索" Margin="0,0,0,12" />
                        <Button Content="＋ 加入本地项目" Command="{Binding ImportCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,0,16" />
                    </StackPanel>
                    <Button DockPanel.Dock="Bottom" Content="恢复未登记仓库" Command="{Binding RecoverCommand}" Margin="0,12,0,0" FontSize="12" ToolTip="查找 repos 中已创建但未写入清单的 .git 仓库" />
                    <ListBox ItemsSource="{Binding FilteredItems}" SelectedItem="{Binding SelectedItem}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" IsEnabled="{Binding CanWork}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="10,14" /><Setter Property="Margin" Value="0,0,0,5" />
                                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Row" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter /></Border>
                                    <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#E9F3F0" /></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="#B9D5CC" /><Setter TargetName="Row" Property="BorderThickness" Value="1" /></Trigger></ControlTemplate.Triggers>
                                </ControlTemplate></Setter.Value></Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate><DataTemplate>
                            <DockPanel><TextBlock Text="{Binding Symbol}" Foreground="{StaticResource Accent}" FontWeight="Bold" Width="23" FontSize="16" />
                                <StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Summary}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap" /></StackPanel>
                            </DockPanel>
                        </DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <Border Grid.Column="2" Background="White" CornerRadius="10" BorderBrush="#DFE6EA" BorderThickness="1" Padding="28">
                <Grid>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440" Visibility="{Binding ShowWelcome, Converter={StaticResource BoolVisibility}}">
                        <TextBlock Text="你的代码，随身携带" FontSize="28" FontWeight="SemiBold" TextAlignment="Center" />
                        <TextBlock Text="把 U 盘变成离线 Git 中转站。&#10;在不同电脑之间，清楚地推送和拉取。" TextAlignment="Center" Style="{StaticResource MutedText}" Margin="0,18,0,30" FontSize="15" />
                        <TextBlock Text="01   创建或打开一个 Vault&#10;&#10;02   加入已有 Git 项目&#10;&#10;03   在另一台电脑克隆并继续工作" Style="{StaticResource MutedText}" FontSize="14" />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HasSelection, Converter={StaticResource BoolVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{Binding DetailTitle}" FontSize="27" FontWeight="SemiBold" />
                            <TextBlock Text="本地工作目录" Style="{StaticResource MutedText}" Margin="0,22,0,4" FontSize="11" />
                            <DockPanel><Button Content="打开目录" Command="{Binding OpenLocalCommand}" DockPanel.Dock="Right" Padding="10,5" Margin="12,0,0,0" /><TextBlock Text="{Binding LocalPath}" TextWrapping="Wrap" VerticalAlignment="Center" /></DockPanel>
                            <TextBlock Text="U 盘裸仓库" Style="{StaticResource MutedText}" Margin="0,14,0,4" FontSize="11" />
                            <TextBlock Text="{Binding RemotePath}" TextWrapping="Wrap" />
                            <Border Background="#F3F7F6" CornerRadius="8" Padding="18" Margin="0,24,0,18">
                                <StackPanel>
                                    <TextBlock Text="{Binding BranchText, StringFormat=当前分支：{0}}" Foreground="{StaticResource Muted}" FontSize="12" />
                                    <TextBlock Text="{Binding StatusText}" FontSize="21" FontWeight="SemiBold" Margin="0,9,0,8" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding WorktreeText}" Style="{StaticResource MutedText}" FontSize="12" />
                                </StackPanel>
                            </Border>
                            <WrapPanel Margin="0,0,0,12">
                                <Button Content="{Binding PushLabel}" Command="{Binding PushCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" />
                                <Button Content="↓ 从 U 盘拉取" Command="{Binding PullCommand}" Margin="0,0,8,8" />
                                <Button Content="克隆到本机" Command="{Binding CloneCommand}" Margin="0,0,8,8" />
                                <Button Content="绑定已有项目" Command="{Binding BindCommand}" Margin="0,0,0,8" />
                            </WrapPanel>
                            <TextBlock Text="{Binding Guidance}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,24" />
                            <TextBlock Text="最近提交" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12" />
                            <ItemsControl ItemsSource="{Binding Commits}"><ItemsControl.ItemTemplate><DataTemplate>
                                <Border BorderBrush="#EBEFF2" BorderThickness="0,0,0,1" Padding="0,12">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="78" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Hash}" FontFamily="Consolas" Foreground="{StaticResource Accent}" />
                                        <StackPanel Grid.Column="1"><TextBlock Text="{Binding Subject}" TextWrapping="Wrap" /><TextBlock Foreground="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0"><Run Text="{Binding Author}" /><Run Text=" · " /><Run Text="{Binding Time}" /></TextBlock></StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
        <Border Grid.Row="3" Background="White" BorderBrush="#E1E7EB" BorderThickness="0,1,0,0" Padding="28,12">
            <StackPanel>
                <DockPanel>
                    <Button Content="取消操作" Command="{Binding CancelCommand}" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" DockPanel.Dock="Right" Padding="12,5" Margin="12,0,0,0" />
                    <TextBlock Text="{Binding Feedback}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
                <ProgressBar IsIndeterminate="True" Height="3" Margin="0,8,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" />
                <Expander Header="操作日志" IsExpanded="{Binding IsLogOpen}" Margin="0,10,0,0">
                    <DockPanel Margin="0,10,0,0"><Button Content="复制日志" Command="{Binding CopyLogCommand}" DockPanel.Dock="Right" VerticalAlignment="Top" Margin="10,0,0,0" /><TextBox Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" Height="140" FontFamily="Consolas, Microsoft YaHei UI" FontSize="11" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="操作日志内容" /></DockPanel>
                </Expander>
            </StackPanel>
        </Border>
    </Grid>
</Window>
