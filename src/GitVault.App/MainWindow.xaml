<Window x:Class="GitVault.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:GitVault.Core;assembly=GitVault.Core"
        Title="GitVault · 离线代码库" Width="1180" Height="820" MinWidth="980" MinHeight="680"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- 直接依据仓库状态选择图标，刷新失败后恢复为待验证形状。 -->
        <Style x:Key="RepositoryStatusIcon" TargetType="Path" BasedOn="{StaticResource IconPath}">
            <Setter Property="Data" Value="{StaticResource IconPending}" />
            <Setter Property="Stroke" Value="{StaticResource Muted}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status.Kind}" Value="{x:Static core:SyncKind.Synced}"><Setter Property="Data" Value="{StaticResource IconSynced}" /><Setter Property="Stroke" Value="{StaticResource Accent}" /></DataTrigger>
                <DataTrigger Binding="{Binding Status.Kind}" Value="{x:Static core:SyncKind.Ahead}"><Setter Property="Data" Value="{StaticResource IconAhead}" /><Setter Property="Stroke" Value="{StaticResource Accent}" /></DataTrigger>
                <DataTrigger Binding="{Binding Status.Kind}" Value="{x:Static core:SyncKind.Behind}"><Setter Property="Data" Value="{StaticResource IconBehind}" /><Setter Property="Stroke" Value="{StaticResource Accent}" /></DataTrigger>
                <DataTrigger Binding="{Binding Status.Kind}" Value="{x:Static core:SyncKind.Diverged}"><Setter Property="Data" Value="{StaticResource IconDiverged}" /><Setter Property="Stroke" Value="#C98A25" /></DataTrigger>
                <DataTrigger Binding="{Binding Status.Kind}" Value="{x:Static core:SyncKind.MissingBranch}"><Setter Property="Data" Value="{StaticResource IconBranch}" /><Setter Property="Stroke" Value="{StaticResource Accent}" /></DataTrigger>
                <DataTrigger Binding="{Binding Status.Kind}" Value="{x:Static core:SyncKind.Unrelated}"><Setter Property="Data" Value="{StaticResource IconWarning}" /><Setter Property="Stroke" Value="#C98A25" /></DataTrigger>
                <DataTrigger Binding="{Binding Status.Kind}" Value="{x:Static core:SyncKind.Unsupported}"><Setter Property="Data" Value="{StaticResource IconWarning}" /><Setter Property="Stroke" Value="#C98A25" /></DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="84" /><RowDefinition Height="80" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Border Background="White" BorderBrush="#E1E7EB" BorderThickness="0,0,0,1" Padding="28,18">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button Content="选择已有代码库" Command="{Binding OpenLibraryCommand}" Tag="{StaticResource IconFolder}" />
                    <Button Content="创建 U 盘代码库" Command="{Binding CreateLibraryCommand}" Tag="{StaticResource IconCreate}" />
                    <Button Content="设置" Command="{Binding SettingsCommand}" Tag="{StaticResource IconSettings}" Margin="0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="{StaticResource AppLogo}" Width="40" Height="40" Margin="0,0,12,0" AutomationProperties.Name="GitVault 随身代码" />
                    <StackPanel><TextBlock Text="GitVault" FontSize="24" FontWeight="Bold" /><TextBlock Text="离线代码库 / OFFLINE GIT" FontSize="10" Foreground="{StaticResource Muted}" /></StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Row="1" Margin="28,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding VaultTitle}" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="{Binding VaultPath}" Foreground="{StaticResource Muted}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ComboBox ItemsSource="{Binding VaultChoices}" SelectedItem="{Binding SelectedVault}" DisplayMemberPath="Label" Width="240" Padding="8" Margin="12,0" IsEnabled="{Binding CanWork}" AutomationProperties.Name="选择代码库位置" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
                    <Viewbox Width="16" Height="16" Margin="0,0,6,0"><Canvas Width="24" Height="24"><Path>
                        <Path.Style><Style TargetType="Path" BasedOn="{StaticResource IconPath}">
                            <Setter Property="Data" Value="{StaticResource IconOffline}" /><Setter Property="Stroke" Value="{StaticResource Muted}" />
                            <Style.Triggers><DataTrigger Binding="{Binding IsOnline}" Value="True"><Setter Property="Data" Value="{StaticResource IconSynced}" /><Setter Property="Stroke" Value="{StaticResource Accent}" /></DataTrigger></Style.Triggers>
                        </Style></Path.Style>
                    </Path></Canvas></Viewbox>
                    <TextBlock Text="{Binding ConnectionText}" Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                </StackPanel>
                <Button Content="扫描 U 盘" Command="{Binding DiscoverCommand}" Tag="{StaticResource IconScan}" />
                <Button Content="刷新" Command="{Binding RefreshCommand}" Tag="{StaticResource IconRefresh}" Margin="0" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="2" Margin="28,0,28,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="266" /><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Background="White" CornerRadius="10" BorderBrush="#DFE6EA" BorderThickness="1">
                <DockPanel Margin="16">
                    <StackPanel DockPanel.Dock="Top">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Viewbox Width="17" Height="17" Margin="0,0,7,0"><Canvas Width="24" Height="24"><Path Data="{StaticResource IconRepository}" Style="{StaticResource IconPath}" Stroke="{StaticResource Accent}" /></Canvas></Viewbox>
                            <TextBlock Text="U 盘项目" FontSize="15" FontWeight="SemiBold" />
                        </StackPanel>
                        <Grid Margin="0,0,0,12">
                            <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="搜索项目" ToolTip="按项目名称搜索" Padding="32,8,10,8" />
                            <Viewbox Width="16" Height="16" HorizontalAlignment="Left" Margin="10,0,0,0" IsHitTestVisible="False"><Canvas Width="24" Height="24"><Path Data="{StaticResource IconSearch}" Style="{StaticResource IconPath}" Stroke="{StaticResource Muted}" /></Canvas></Viewbox>
                        </Grid>
                        <Button Content="加入 U 盘代码库" Command="{Binding ImportCommand}" Tag="{StaticResource IconImport}" Style="{StaticResource PrimaryButton}" Margin="0,0,0,16" />
                    </StackPanel>
                    <Button DockPanel.Dock="Bottom" Content="恢复仓库列表" Command="{Binding RecoverCommand}" Tag="{StaticResource IconRecover}" Margin="0,12,0,0" FontSize="12" ToolTip="查找代码库中已创建但未加入列表的项目" />
                    <ListBox ItemsSource="{Binding FilteredItems}" SelectedItem="{Binding SelectedItem}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" IsEnabled="{Binding CanWork}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="10,14" /><Setter Property="Margin" Value="0,0,0,5" />
                                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Row" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter /></Border>
                                    <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#E9F3F0" /></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="#B9D5CC" /><Setter TargetName="Row" Property="BorderThickness" Value="1" /></Trigger></ControlTemplate.Triggers>
                                </ControlTemplate></Setter.Value></Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate><DataTemplate>
                            <DockPanel><Viewbox Width="18" Height="18" Margin="0,1,8,0" VerticalAlignment="Top"><Canvas Width="24" Height="24"><Path Style="{StaticResource RepositoryStatusIcon}" /></Canvas></Viewbox>
                                <StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Summary}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap" /></StackPanel>
                            </DockPanel>
                        </DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <Border Grid.Column="2" Background="White" CornerRadius="10" BorderBrush="#DFE6EA" BorderThickness="1" Padding="28">
                <Grid>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460" Visibility="{Binding ShowDisconnected, Converter={StaticResource BoolVisibility}}">
                        <Viewbox Width="56" Height="56" Margin="0,0,0,22"><Canvas Width="24" Height="24"><Path Data="{StaticResource IconOffline}" Style="{StaticResource IconPath}" Stroke="{StaticResource Muted}" /></Canvas></Viewbox>
                        <TextBlock Text="尚未连接 U 盘代码库" FontSize="28" FontWeight="SemiBold" TextAlignment="Center" />
                        <TextBlock Text="插入 U 盘后会自动识别其中的代码库。&#10;如果 U 盘已在电脑上，也可以手动扫描或选择目录。" TextAlignment="Center" Style="{StaticResource MutedText}" Margin="0,18,0,30" FontSize="15" />
                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="扫描 U 盘" Command="{Binding DiscoverCommand}" Tag="{StaticResource IconScan}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" />
                            <Button Content="选择已有代码库" Command="{Binding OpenLibraryCommand}" Tag="{StaticResource IconFolder}" Margin="0,0,8,8" />
                            <Button Content="创建 U 盘代码库" Command="{Binding CreateLibraryCommand}" Tag="{StaticResource IconCreate}" Margin="0,0,0,8" />
                        </WrapPanel>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440" Visibility="{Binding ShowWelcome, Converter={StaticResource BoolVisibility}}">
                        <Image Source="{StaticResource AppLogo}" Width="64" Height="64" Margin="0,0,0,22" />
                        <TextBlock Text="你的代码，随身携带" FontSize="28" FontWeight="SemiBold" TextAlignment="Center" />
                        <TextBlock Text="把 U 盘变成离线 Git 中转站。&#10;在不同电脑之间，清楚地推送和拉取。" TextAlignment="Center" Style="{StaticResource MutedText}" Margin="0,18,0,30" FontSize="15" />
                        <TextBlock Text="01   创建或选择 U 盘代码库&#10;&#10;02   把本地 Git 项目加入代码库&#10;&#10;03   在另一台电脑克隆并继续工作" Style="{StaticResource MutedText}" FontSize="14" />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HasSelection, Converter={StaticResource BoolVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{Binding DetailTitle}" FontSize="27" FontWeight="SemiBold" />
                            <TextBlock Text="本地工作目录" Style="{StaticResource MutedText}" Margin="0,22,0,4" FontSize="11" />
                            <DockPanel><Button Content="打开目录" Command="{Binding OpenLocalCommand}" Tag="{StaticResource IconFolder}" DockPanel.Dock="Right" Padding="10,5" Margin="12,0,0,0" /><TextBlock Text="{Binding LocalPath}" TextWrapping="Wrap" VerticalAlignment="Center" /></DockPanel>
                            <TextBlock Text="U 盘中的位置" Style="{StaticResource MutedText}" Margin="0,14,0,4" FontSize="11" />
                            <TextBlock Text="{Binding RemotePath}" TextWrapping="Wrap" />
                            <Border Background="#F3F7F6" CornerRadius="8" Padding="18" Margin="0,24,0,18">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Viewbox Width="14" Height="14" Margin="0,0,7,0"><Canvas Width="24" Height="24"><Path Data="{StaticResource IconBranch}" Style="{StaticResource IconPath}" Stroke="{StaticResource Muted}" /></Canvas></Viewbox>
                                        <TextBlock Text="{Binding BranchText, StringFormat=当前分支：{0}}" Foreground="{StaticResource Muted}" FontSize="12" />
                                    </StackPanel>
                                    <DockPanel Margin="0,9,0,8">
                                        <Viewbox Width="22" Height="22" Margin="0,0,9,0" VerticalAlignment="Center" DataContext="{Binding SelectedItem}"><Canvas Width="24" Height="24"><Path Style="{StaticResource RepositoryStatusIcon}" /></Canvas></Viewbox>
                                        <TextBlock Text="{Binding StatusText}" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding WorktreeText}" Style="{StaticResource MutedText}" FontSize="12" />
                                </StackPanel>
                            </Border>
                            <WrapPanel Margin="0,0,0,12">
                                <Button Content="{Binding PushLabel}" Command="{Binding PushCommand}" Tag="{StaticResource IconPush}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" />
                                <Button Content="从 U 盘拉取" Command="{Binding PullCommand}" Tag="{StaticResource IconPull}" Margin="0,0,8,8" />
                                <Button Content="克隆到本机" Command="{Binding CloneCommand}" Tag="{StaticResource IconClone}" Margin="0,0,8,8" />
                                <Button Content="绑定已有项目" Command="{Binding BindCommand}" Tag="{StaticResource IconBind}" Margin="0,0,0,8" />
                            </WrapPanel>
                            <TextBlock Text="{Binding Guidance}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,24" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Viewbox Width="16" Height="16" Margin="0,0,7,0"><Canvas Width="24" Height="24"><Path Data="{StaticResource IconHistory}" Style="{StaticResource IconPath}" /></Canvas></Viewbox>
                                <TextBlock Text="最近提交" FontSize="15" FontWeight="SemiBold" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Commits}"><ItemsControl.ItemTemplate><DataTemplate>
                                <Border BorderBrush="#EBEFF2" BorderThickness="0,0,0,1" Padding="0,12">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="78" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Hash}" FontFamily="Consolas" Foreground="{StaticResource Accent}" />
                                        <StackPanel Grid.Column="1"><TextBlock Text="{Binding Subject}" TextWrapping="Wrap" /><TextBlock Foreground="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0"><Run Text="{Binding Author}" /><Run Text=" · " /><Run Text="{Binding Time}" /></TextBlock></StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
        <Border Grid.Row="3" Background="White" BorderBrush="#E1E7EB" BorderThickness="0,1,0,0" Padding="28,12">
            <StackPanel>
                <DockPanel>
                    <Button Content="取消操作" Command="{Binding CancelCommand}" Tag="{StaticResource IconCancel}" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" DockPanel.Dock="Right" Padding="12,5" Margin="12,0,0,0" />
                    <TextBlock Text="{Binding Feedback}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
                <ProgressBar IsIndeterminate="True" Height="3" Margin="0,8,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" />
                <Expander IsExpanded="{Binding IsLogOpen}" Margin="0,10,0,0">
                    <Expander.Header><StackPanel Orientation="Horizontal">
                        <Viewbox Width="14" Height="14" Margin="0,0,6,0"><Canvas Width="24" Height="24"><Path Data="{StaticResource IconLog}" Style="{StaticResource IconPath}" /></Canvas></Viewbox>
                        <TextBlock Text="操作日志" />
                    </StackPanel></Expander.Header>
                    <DockPanel Margin="0,10,0,0"><Button Content="复制日志" Command="{Binding CopyLogCommand}" Tag="{StaticResource IconCopy}" DockPanel.Dock="Right" VerticalAlignment="Top" Margin="10,0,0,0" /><TextBox Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" Height="140" FontFamily="Consolas, Microsoft YaHei UI" FontSize="11" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="操作日志内容" /></DockPanel>
                </Expander>
            </StackPanel>
        </Border>
    </Grid>
</Window>
